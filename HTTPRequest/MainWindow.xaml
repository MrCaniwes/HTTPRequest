<Window x:Class="HTTPRequest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HTTPRequest"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="HTTP Client Studio - Cyber Dark Edition" 
        Height="820" Width="1140" 
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#030712">

    <!-- Modern Windows Çerçeve Yönetimi (WindowChrome) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Titlebar Buton Stili -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kapat Butonu Özel Kırmızı Hover Stili -->
        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Özel Başlık Çubuğu (Custom Title Bar) -->
            <RowDefinition Height="38"/>
            <!-- 1: WebView2 ve Uygulama İçeriği -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÖZEL KOYU BAŞLIK ÇUBUĞU (CUSTOM TITLE BAR) -->
        <Border Grid.Row="0" Background="#04060E" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol Bölüm: Logo ve Başlık -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Background="#1500F5D4" BorderBrush="#6000F5D4" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                        <TextBlock Text="◈" FontSize="11" Foreground="#00F5D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="API COCKPIT STUDIO" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#2000F5D4" BorderBrush="#5000F5D4" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="4,1">
                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="#00F5D4"/>
                    </Border>
                </StackPanel>

                <!-- Orta Bölüm: Drag / Bilgi Alanı -->
                <TextBlock Grid.Column="1" Text="Native Zero-CORS Engine" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Sağ Bölüm: Minimize, Maximize ve Kapat Butonları -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarBtn}" Content="—" Click="BtnMinimize_Click" ToolTip="Simge Durumuna Küçült"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarBtn}" Content="▢" Click="BtnMaximize_Click" ToolTip="Ekranı Kapla / Geri Yükle"/>
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseBtn}" Content="✕" Click="BtnClose_Click" ToolTip="Kapat"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WEBVIEW2 VE YÜKLENİYOR KATMANI -->
        <Grid Grid.Row="1">
            <!-- WebView2 Modern Web Bileşeni -->
            <wv2:WebView2 x:Name="webView" 
                           WebMessageReceived="webView_WebMessageReceived"/>

            <!-- Yükleniyor Katmanı -->
            <Grid x:Name="LoadingOverlay" Background="#030712" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="HTTP Client Studio Başlatılıyor..." FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock Text="WebView2 motoru ve arayüz yükleniyor, lütfen bekleyiniz." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
